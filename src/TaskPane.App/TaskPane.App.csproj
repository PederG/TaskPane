<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10 TFM enables WinRT toast APIs for unpackaged self-contained WPF. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon />
    <StartupObject>TaskPane.App.App</StartupObject>
    <RootNamespace>TaskPane.App</RootNamespace>
    <AssemblyName>TaskPane</AssemblyName>
    <Product>TaskPane</Product>
    <AssemblyTitle>TaskPane</AssemblyTitle>
    <Description>Offline-first Windows task overlay</Description>
    <Version>0.7.2</Version>
    <InformationalVersion>0.7.2-compact-session</InformationalVersion>
    <Company>TaskPane</Company>
    <Copyright>Copyright (c) TaskPane contributors</Copyright>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- Applied only when publishing a self-contained win-x64 folder build. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskPane.Core\TaskPane.Core.csproj" />
    <ProjectReference Include="..\TaskPane.Application\TaskPane.Application.csproj" />
    <ProjectReference Include="..\TaskPane.Infrastructure\TaskPane.Infrastructure.csproj" />
  </ItemGroup>

</Project>
