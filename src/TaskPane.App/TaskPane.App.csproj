<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon />
    <StartupObject>TaskPane.App.App</StartupObject>
    <RootNamespace>TaskPane.App</RootNamespace>
    <AssemblyName>TaskPane</AssemblyName>
    <Product>TaskPane</Product>
    <AssemblyTitle>TaskPane</AssemblyTitle>
    <Description>Offline-first Windows task overlay</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskPane.Core\TaskPane.Core.csproj" />
    <ProjectReference Include="..\TaskPane.Application\TaskPane.Application.csproj" />
    <ProjectReference Include="..\TaskPane.Infrastructure\TaskPane.Infrastructure.csproj" />
  </ItemGroup>

</Project>
