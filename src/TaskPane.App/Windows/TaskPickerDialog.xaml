<Window x:Class="TaskPane.App.Windows.TaskPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="400"
        Height="420"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Border Padding="16">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="{Binding Title}"
                 FontWeight="SemiBold"
                 FontSize="15"
                 Margin="0,0,0,4" />
      <TextBlock DockPanel.Dock="Top"
                 Text="{Binding Prompt}"
                 TextWrapping="Wrap"
                 Opacity="0.75"
                 Margin="0,0,0,12" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <ui:Button Content="Cancel"
                   Appearance="Secondary"
                   Margin="0,0,8,0"
                   IsCancel="True"
                   Click="Cancel_OnClick" />
        <ui:Button Content="Add"
                   Appearance="Primary"
                   IsDefault="True"
                   Click="Confirm_OnClick"
                   AutomationProperties.Name="Confirm task pick" />
      </StackPanel>
      <ui:TextBox DockPanel.Dock="Top"
                  PlaceholderText="Filter by title…"
                  Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,0,0,8"
                  AutomationProperties.Name="Filter task picker" />
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedItem}"
               DisplayMemberPath="Title"
               BorderThickness="1"
               AutomationProperties.Name="Task picker list" />
    </DockPanel>
  </Border>
</Window>
