<ui:FluentWindow x:Class="TaskPane.App.Windows.ManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:enums="clr-namespace:TaskPane.Core.Enums;assembly=TaskPane.Core"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="TaskPane — Manager"
                 Height="740"
                 Width="1180"
                 MinWidth="920"
                 MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 AllowDrop="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="TaskPane">
      <ui:TitleBar.TrailingContent>
        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
          <ui:Button Margin="0,0,8,0"
                     Appearance="Secondary"
                     Command="{Binding ToggleThemeCommand}"
                     ToolTip="Toggle light / dark theme"
                     AutomationProperties.Name="Toggle theme">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="WeatherSunny24" Margin="0,0,6,0" />
              <TextBlock Text="Theme" VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>
          <ui:Button Appearance="Primary"
                     Command="{Binding ReturnToOverlayCommand}"
                     AutomationProperties.Name="Return to overlay">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="PanelLeftExpand24" Margin="0,0,6,0" />
              <TextBlock Text="Return to overlay" VerticalAlignment="Center" />
            </StackPanel>
          </ui:Button>
        </StackPanel>
      </ui:TitleBar.TrailingContent>
    </ui:TitleBar>

    <Grid Grid.Row="1" Margin="0,0,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Margin="12,0,8,0"
              Padding="8"
              CornerRadius="{StaticResource TpRadiusMd}"
              Background="{DynamicResource ControlFillColorDefaultBrush}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="8,8,8,12">
            <TextBlock Text="TaskPane" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Manager" Opacity="0.6" FontSize="12" Margin="0,2,0,0" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom"
                     Text="{Binding StatusMessage}"
                     TextWrapping="Wrap"
                     Opacity="0.65"
                     FontSize="11"
                     Margin="8,8,8,4" />
          <ListBox ItemsSource="{Binding NavItems}"
                   SelectedItem="{Binding SelectedNavItem}"
                   Style="{StaticResource TpNavListBox}"
                   AutomationProperties.Name="Manager navigation">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
          <ui:Button DockPanel.Dock="Right"
                     Content="Undo"
                     Appearance="Secondary"
                     Padding="12,6"
                     Command="{Binding UndoLatestCommand}"
                     AutomationProperties.Name="Undo latest change" />
          <TextBlock Text="{Binding WorkspaceTitle}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1"
                Padding="10"
                Margin="0,0,0,10"
                CornerRadius="{StaticResource TpRadiusMd}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0"
                          PlaceholderText="Search title and notes"
                          Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,8,0"
                          AutomationProperties.Name="Search title and notes" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Projects}"
                        SelectedItem="{Binding FilterProject}"
                        DisplayMemberPath="Name"
                        Margin="0,0,8,0"
                        IsEditable="False"
                        ToolTip="Filter by project" />
              <ComboBox Grid.Column="2"
                        ItemsSource="{Binding Tags}"
                        SelectedItem="{Binding FilterTag}"
                        DisplayMemberPath="Name"
                        Margin="0,0,8,0"
                        ToolTip="Filter by tag" />
              <ComboBox Grid.Column="3"
                        SelectedItem="{Binding SortMode}"
                        MinWidth="120"
                        ToolTip="Sort mode">
                <enums:TaskSortMode>Manual</enums:TaskSortMode>
                <enums:TaskSortMode>Priority</enums:TaskSortMode>
                <enums:TaskSortMode>Deadline</enums:TaskSortMode>
                <enums:TaskSortMode>CreatedDesc</enums:TaskSortMode>
              </ComboBox>
            </Grid>
            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
              <CheckBox Content="Include sleeping" IsChecked="{Binding IncludeSleeping}" Margin="0,0,12,0" VerticalAlignment="Center" />
              <CheckBox Content="Only sleeping" IsChecked="{Binding OnlySleeping}" Margin="0,0,12,0" VerticalAlignment="Center" />
              <CheckBox Content="Only waiting" IsChecked="{Binding OnlyWaiting}" Margin="0,0,12,0" VerticalAlignment="Center" />
              <CheckBox Content="Only blocked" IsChecked="{Binding OnlyBlocked}" Margin="0,0,12,0" VerticalAlignment="Center" />
              <CheckBox Content="Hide blocked" IsChecked="{Binding HideBlocked}" VerticalAlignment="Center" />
            </WrapPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="340" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Padding="10"
                  CornerRadius="{StaticResource TpRadiusMd}"
                  Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowingRecycleBin}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ShowingHistory}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ShowingReports}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="New task title"
                            KeyDown="NewTaskBox_OnKeyDown"
                            AutomationProperties.Name="New task title" />
                <ui:Button Grid.Column="1"
                           Content="Add"
                           Appearance="Primary"
                           Margin="8,0,0,0"
                           Padding="14,6"
                           Command="{Binding CreateTaskCommand}" />
              </Grid>

              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowingRecycleBin}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ShowingHistory}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ShowingReports}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <ui:Button Content="↑" Width="36" Margin="0,0,4,0" Appearance="Secondary" Command="{Binding MoveSelectedUpCommand}" ToolTip="Move up" />
                <ui:Button Content="↓" Width="36" Margin="0,0,8,0" Appearance="Secondary" Command="{Binding MoveSelectedDownCommand}" ToolTip="Move down" />
                <ui:Button Content="Promote" Appearance="Secondary" Padding="10,4" Command="{Binding PromoteSelectedCommand}" />
              </StackPanel>

              <ListBox x:Name="TaskList"
                       ItemsSource="{Binding Tasks}"
                       SelectedItem="{Binding SelectedTask}"
                       AllowDrop="True"
                       BorderThickness="0"
                       Background="Transparent"
                       PreviewMouseMove="TaskList_OnPreviewMouseMove"
                       Drop="TaskList_OnDrop"
                       DragOver="TaskList_OnDragOver">
                <ListBox.Style>
                  <Style TargetType="ListBox">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowingRecycleBin}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ShowingHistory}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ShowingReports}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                                <Setter Property="Margin" Value="18,0,0,0" />
                                <Setter Property="FontWeight" Value="Normal" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.65" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <ListBox ItemsSource="{Binding DeletedTasks}"
                       BorderThickness="0"
                       Background="Transparent">
                <ListBox.Style>
                  <Style TargetType="ListBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowingRecycleBin}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <ui:Button DockPanel.Dock="Right"
                                 Content="Restore"
                                 Appearance="Secondary"
                                 Margin="8,0,0,0"
                                 Command="{Binding DataContext.RestoreDeletedCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                 CommandParameter="{Binding}" />
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <ListBox ItemsSource="{Binding HistoryRows}"
                       BorderThickness="0"
                       Background="Transparent">
                <ListBox.Style>
                  <Style TargetType="ListBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowingHistory}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,4">
                      <ui:Button DockPanel.Dock="Right"
                                 Content="Undo"
                                 Appearance="Secondary"
                                 Margin="8,0,0,0"
                                 Padding="8,4"
                                 Command="{Binding DataContext.UndoHistoryRowCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                 CommandParameter="{Binding}"
                                 IsEnabled="{Binding IsUndoable}" />
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <DockPanel>
                <DockPanel.Style>
                  <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowingReports}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <ui:Button Content="Refresh reports"
                             Appearance="Primary"
                             HorizontalAlignment="Left"
                             Padding="12,6"
                             Command="{Binding RefreshReportCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding ReportLines}"
                         BorderThickness="0"
                         Background="Transparent" />
              </DockPanel>
            </DockPanel>
          </Border>

          <Border Grid.Column="2"
                  Padding="14"
                  CornerRadius="{StaticResource TpRadiusMd}"
                  Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Task details"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,12" />
                <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,16,0,0">
                  <ui:Button Content="Add subtask" Margin="0,0,8,8" Appearance="Secondary" Command="{Binding AddSubtaskToSelectedCommand}" />
                  <ui:Button Content="Sleep 1h" Margin="0,0,8,8" Appearance="Secondary" Command="{Binding SleepSelectedCommand}" CommandParameter="OneHour" />
                  <ui:Button Content="Sleep ∞" Margin="0,0,8,8" Appearance="Secondary" Command="{Binding SleepSelectedCommand}" CommandParameter="Indefinitely" />
                  <ui:Button Content="Wake" Margin="0,0,8,8" Appearance="Secondary" Command="{Binding WakeSelectedCommand}" />
                  <ui:Button Content="Complete" Margin="0,0,8,8" Appearance="Primary" Command="{Binding CompleteSelectedCommand}" />
                  <ui:Button Content="Delete" Margin="0,0,8,8" Appearance="Danger" Command="{Binding SoftDeleteSelectedCommand}" />
                  <ui:Button Content="Save" Margin="0,0,0,8" Appearance="Primary" Command="{Binding SaveSelectedCommand}" />
                </WrapPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Title" />
                  <ui:TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Notes (Markdown / plain text)" />
                  <ui:TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                              AcceptsReturn="True"
                              AcceptsTab="True"
                              TextWrapping="Wrap"
                              Height="140"
                              FontFamily="Cascadia Mono, Consolas, Courier New"
                              Margin="0,0,0,12"
                              AutomationProperties.Name="Task notes editor" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Priority" />
                  <ComboBox SelectedItem="{Binding EditPriority}" Margin="0,0,0,12">
                    <enums:TaskPriority>High</enums:TaskPriority>
                    <enums:TaskPriority>Normal</enums:TaskPriority>
                    <enums:TaskPriority>Low</enums:TaskPriority>
                  </ComboBox>
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Focus" />
                  <ComboBox SelectedItem="{Binding EditFocus}" Margin="0,0,0,12">
                    <enums:FocusBucket>Inbox</enums:FocusBucket>
                    <enums:FocusBucket>Today</enums:FocusBucket>
                    <enums:FocusBucket>Next</enums:FocusBucket>
                    <enums:FocusBucket>Someday</enums:FocusBucket>
                  </ComboBox>
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Deadline date (YYYY-MM-DD, optional)" />
                  <ui:TextBox Text="{Binding EditDeadlineDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Deadline time (optional; leave empty for date-only)" />
                  <ui:TextBox Text="{Binding EditDeadlineTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Waiting for (distinct from sleep / blocked)" />
                  <ui:TextBox Text="{Binding EditWaitingFor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Waiting follow-up (UTC, optional)" />
                  <ui:TextBox Text="{Binding EditWaitingFollowUp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Project" />
                  <ComboBox ItemsSource="{Binding Projects}"
                            SelectedItem="{Binding EditProject}"
                            DisplayMemberPath="Name"
                            Margin="0,0,0,12" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Tags (comma-separated)" />
                  <ui:TextBox Text="{Binding EditTagsCsv, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="RECURRENCE" />
                  <TextBlock Text="{Binding RecurrenceSummary}" Margin="0,0,0,8" Opacity="0.75"
                             AutomationProperties.Name="Recurrence summary" />
                  <ComboBox SelectedItem="{Binding RecurrenceFrequency}" Margin="0,0,0,8">
                    <enums:RecurrenceFrequency>Daily</enums:RecurrenceFrequency>
                    <enums:RecurrenceFrequency>Weekly</enums:RecurrenceFrequency>
                    <enums:RecurrenceFrequency>SelectedWeekdays</enums:RecurrenceFrequency>
                    <enums:RecurrenceFrequency>Monthly</enums:RecurrenceFrequency>
                    <enums:RecurrenceFrequency>CustomIntervalDays</enums:RecurrenceFrequency>
                  </ComboBox>
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Interval" />
                  <ui:TextBox Text="{Binding RecurrenceInterval, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Weekdays (0=Sun…6=Sat, for weekly/selected)" />
                  <ui:TextBox Text="{Binding RecurrenceWeekdays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Day of month (monthly)" />
                  <ui:TextBox Text="{Binding RecurrenceDayOfMonth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Anchor date (YYYY-MM-DD)" />
                  <ui:TextBox Text="{Binding RecurrenceAnchorDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <WrapPanel Margin="0,0,0,16">
                    <ui:Button Content="Attach recurrence" Margin="0,0,8,8" Appearance="Secondary"
                               Command="{Binding AttachRecurrenceCommand}"
                               AutomationProperties.Name="Attach recurrence" />
                    <ui:Button Content="Edit this only" Margin="0,0,8,8" Appearance="Secondary"
                               Command="{Binding DetachThisOccurrenceCommand}"
                               AutomationProperties.Name="Edit this occurrence only" />
                  </WrapPanel>

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="REMINDERS" />
                  <TextBlock Text="{Binding ReminderSummary}" Margin="0,0,0,8" Opacity="0.75"
                             AutomationProperties.Name="Reminder summary" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Due local date/time" />
                  <ui:TextBox Text="{Binding ReminderDueLocal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <ui:Button Content="Schedule reminder" Margin="0,0,0,16" Appearance="Secondary" HorizontalAlignment="Left"
                             Command="{Binding ScheduleReminderCommand}"
                             AutomationProperties.Name="Schedule reminder" />
                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="QUIET HOURS" />
                  <ui:ToggleSwitch Content="Enabled" IsChecked="{Binding QuietHoursEnabled}" Margin="0,0,0,8" />
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Start" Width="40" VerticalAlignment="Center" />
                    <ui:TextBox Text="{Binding QuietStartLocal, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="End" Width="40" VerticalAlignment="Center" />
                    <ui:TextBox Text="{Binding QuietEndLocal, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>
                  <ui:Button Content="Save quiet hours" Margin="0,0,0,16" Appearance="Secondary" HorizontalAlignment="Left"
                             Command="{Binding SaveQuietHoursCommand}"
                             AutomationProperties.Name="Save quiet hours" />

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="DEPENDENCIES" />
                  <TextBlock Text="{Binding BlockedSummary}" Margin="0,0,0,8"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}"
                             AutomationProperties.Name="Blocked status" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Depends on" />
                  <ListBox ItemsSource="{Binding DependsOnLinks}" Height="72" Margin="0,0,0,8"
                           BorderThickness="0" Background="Transparent"
                           AutomationProperties.Name="Depends on list">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <ui:Button DockPanel.Dock="Right" Content="Remove" Margin="8,0,0,0" Padding="6,2"
                                     Appearance="Transparent"
                                     Command="{Binding DataContext.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                     CommandParameter="{Binding}" />
                          <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding OtherTitle, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                          </TextBlock>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Blocks" />
                  <ListBox ItemsSource="{Binding BlocksLinks}" Height="72" Margin="0,0,0,8"
                           DisplayMemberPath="OtherTitle"
                           BorderThickness="0" Background="Transparent"
                           AutomationProperties.Name="Blocks list" />
                  <DockPanel Margin="0,0,0,16">
                    <ui:Button DockPanel.Dock="Right" Content="Add required" Margin="8,0,0,0" Padding="8,4"
                               Appearance="Secondary"
                               Command="{Binding AddDependencyCommand}"
                               AutomationProperties.Name="Add required dependency" />
                    <ComboBox ItemsSource="{Binding DependencyCandidates}"
                              SelectedItem="{Binding SelectedPredecessor}"
                              DisplayMemberPath="Title"
                              AutomationProperties.Name="Predecessor task" />
                  </DockPanel>

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="TIME TRACKING" />
                  <TextBlock Text="{Binding TimeTotalsText}" Margin="0,0,0,8" Opacity="0.75" />
                  <WrapPanel Margin="0,0,0,8">
                    <ui:Button Content="▶ / ■ Timer" Margin="0,0,8,8" Appearance="Primary"
                               Command="{Binding ToggleTimerSelectedCommand}"
                               AutomationProperties.Name="Toggle timer for selected task" />
                    <ui:Button Content="Add 30m session" Margin="0,0,8,8" Appearance="Secondary"
                               Command="{Binding AddManualSessionCommand}" />
                  </WrapPanel>
                  <ListBox ItemsSource="{Binding Sessions}"
                           SelectedItem="{Binding SelectedSession}"
                           Height="110"
                           Margin="0,0,0,8"
                           DisplayMemberPath="Display"
                           BorderThickness="0" Background="Transparent"
                           AutomationProperties.Name="Task time sessions" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Session start (UTC)" />
                  <ui:TextBox Text="{Binding EditSessionStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <TextBlock Style="{StaticResource TpFieldLabel}" Text="Session end (UTC)" />
                  <ui:TextBox Text="{Binding EditSessionEnd, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                  <WrapPanel Margin="0,0,0,16">
                    <ui:Button Content="Save session" Margin="0,0,8,8" Appearance="Secondary"
                               Command="{Binding SaveSelectedSessionCommand}" />
                    <ui:Button Content="Discard session" Margin="0,0,8,8" Appearance="Secondary"
                               Command="{Binding DiscardSelectedSessionCommand}" />
                  </WrapPanel>

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="TIME REPORTS" />
                  <TextBlock Text="{Binding ReportSummary}" Margin="0,0,0,8" />
                  <ui:Button Content="Refresh reports" Margin="0,0,0,8" Appearance="Secondary" HorizontalAlignment="Left"
                             Command="{Binding RefreshReportCommand}" />
                  <ListBox ItemsSource="{Binding ReportLines}" Height="100" Margin="0,0,0,16"
                           BorderThickness="0" Background="Transparent" />

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="IDLE THRESHOLD (MINUTES)" />
                  <DockPanel Margin="0,0,0,16">
                    <ui:Button DockPanel.Dock="Right" Content="Save" Margin="8,0,0,0" Padding="8,4"
                               Appearance="Secondary"
                               Command="{Binding SaveIdleThresholdCommand}" />
                    <ui:TextBox Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="PROJECTS / TAGS" />
                  <DockPanel Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Content="Add project" Margin="8,0,0,0" Padding="8,4"
                               Appearance="Secondary"
                               Command="{Binding CreateProjectCommand}" />
                    <ui:TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="New project" />
                  </DockPanel>
                  <DockPanel Margin="0,0,0,16">
                    <ui:Button DockPanel.Dock="Right" Content="Add tag" Margin="8,0,0,0" Padding="8,4"
                               Appearance="Secondary"
                               Command="{Binding CreateTagCommand}" />
                    <ui:TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="New tag" />
                  </DockPanel>

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="QUICK-CAPTURE HOTKEY" />
                  <DockPanel Margin="0,0,0,16">
                    <ui:Button DockPanel.Dock="Right" Content="Save hotkey" Margin="8,0,0,0" Padding="8,4"
                               Appearance="Secondary"
                               Command="{Binding SaveHotkeyCommand}" />
                    <CheckBox DockPanel.Dock="Right" Content="Enabled" IsChecked="{Binding HotkeyEnabled}"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:TextBox Text="{Binding HotkeyLabel, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Examples: Ctrl+Alt+Space, Ctrl+Shift+Q" />
                  </DockPanel>

                  <TextBlock Style="{StaticResource TpSectionLabel}" Text="BACKUP / IMPORT / EXPORT" />
                  <TextBlock Text="{Binding BackupStatusText}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,8"
                             Opacity="0.75"
                             AutomationProperties.Name="Backup status" />
                  <WrapPanel Margin="0,0,0,8">
                    <ui:Button Content="Backup now" Margin="0,0,8,8" Appearance="Primary" Padding="8,4"
                               Command="{Binding BackupNowCommand}"
                               AutomationProperties.Name="Backup now" />
                    <ui:Button Content="Export JSON" Margin="0,0,8,8" Appearance="Secondary" Padding="8,4"
                               Command="{Binding ExportJsonCommand}" />
                    <ui:Button Content="Export Markdown" Margin="0,0,8,8" Appearance="Secondary" Padding="8,4"
                               Command="{Binding ExportMarkdownCommand}"
                               ToolTip="Human-readable only — not a full restore format." />
                    <ui:Button Content="Preview import" Margin="0,0,8,8" Appearance="Secondary" Padding="8,4"
                               Command="{Binding PreviewImportCommand}" />
                    <ui:Button Content="Import JSON" Margin="0,0,8,8" Appearance="Secondary" Padding="8,4"
                               Command="{Binding ImportJsonCommand}" />
                    <ui:Button Content="Restore backup" Margin="0,0,8,8" Appearance="Secondary" Padding="8,4"
                               Command="{Binding RestoreBackupCommand}" />
                    <ui:Button Content="Recovery help" Margin="0,0,8,8" Appearance="Secondary" Padding="8,4"
                               Command="{Binding ShowRecoveryHelpCommand}" />
                  </WrapPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Import mode" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox SelectedItem="{Binding SelectedImportMode}">
                      <enums:ImportMode>MergeByIdSkipConflicts</enums:ImportMode>
                      <enums:ImportMode>MergeByIdFailOnConflict</enums:ImportMode>
                      <enums:ImportMode>ImportAsNew</enums:ImportMode>
                    </ComboBox>
                  </DockPanel>
                  <TextBlock Text="{Binding ImportPreviewText}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,8"
                             Opacity="0.75" />
                </StackPanel>
              </DockPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
