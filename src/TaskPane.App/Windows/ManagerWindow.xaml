<Window x:Class="TaskPane.App.Windows.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:TaskPane.Core.Enums;assembly=TaskPane.Core"
        Title="TaskPane — Manager"
        Height="640"
        Width="960"
        MinWidth="720"
        MinHeight="480"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#FFF7F8FA">
  <DockPanel Margin="12">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right"
              Content="Return to overlay"
              Padding="12,6"
              Command="{Binding ReturnToOverlayCommand}"
              AutomationProperties.Name="Return to overlay" />
      <TextBlock Text="TaskPane Manager" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
      <ComboBox Width="140" SelectedItem="{Binding SelectedFocus}" Margin="0,0,8,0">
        <enums:FocusBucket>Inbox</enums:FocusBucket>
        <enums:FocusBucket>Today</enums:FocusBucket>
        <enums:FocusBucket>Next</enums:FocusBucket>
        <enums:FocusBucket>Someday</enums:FocusBucket>
      </ComboBox>
      <Button Content="Tasks" Margin="0,0,8,0" Command="{Binding ShowTasksCommand}" Padding="10,4" />
      <Button Content="Recycle bin" Command="{Binding ShowRecycleBinCommand}" Padding="10,4" />
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                   Padding="8,6"
                   KeyDown="NewTaskBox_OnKeyDown"
                   AutomationProperties.Name="New task title" />
          <Button Grid.Column="1" Content="Add" Margin="8,0,0,0" Padding="12,6"
                  Command="{Binding CreateTaskCommand}" />
        </Grid>

        <ListBox x:Name="TaskList"
                 ItemsSource="{Binding Tasks}"
                 SelectedItem="{Binding SelectedTask}">
          <ListBox.Style>
            <Style TargetType="ListBox">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowingRecycleBin}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#FF555555" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ListBox ItemsSource="{Binding DeletedTasks}">
          <ListBox.Style>
            <Style TargetType="ListBox">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowingRecycleBin}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restore" Margin="8,0,0,0"
                        Command="{Binding DataContext.RestoreDeletedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <Border Grid.Column="2" Background="White" BorderBrush="#22000000" BorderThickness="1" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Task details" FontWeight="SemiBold" Margin="0,0,0,10" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Add subtask" Margin="0,0,8,0" Padding="10,6"
                    Command="{Binding AddSubtaskToSelectedCommand}" />
            <Button Content="Complete" Margin="0,0,8,0" Padding="10,6"
                    Command="{Binding CompleteSelectedCommand}" />
            <Button Content="Delete" Margin="0,0,8,0" Padding="10,6"
                    Command="{Binding SoftDeleteSelectedCommand}" />
            <Button Content="Save" Padding="10,6" Command="{Binding SaveSelectedCommand}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Title" Margin="0,0,0,4" />
            <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" />
            <TextBlock Text="Notes" Margin="0,0,0,4" />
            <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="140"
                     Padding="8,6"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,10" />
            <TextBlock Text="Priority" Margin="0,0,0,4" />
            <ComboBox SelectedItem="{Binding EditPriority}" Margin="0,0,0,10">
              <enums:TaskPriority>High</enums:TaskPriority>
              <enums:TaskPriority>Normal</enums:TaskPriority>
              <enums:TaskPriority>Low</enums:TaskPriority>
            </ComboBox>
            <TextBlock Text="Focus" Margin="0,0,0,4" />
            <ComboBox SelectedItem="{Binding EditFocus}">
              <enums:FocusBucket>Inbox</enums:FocusBucket>
              <enums:FocusBucket>Today</enums:FocusBucket>
              <enums:FocusBucket>Next</enums:FocusBucket>
              <enums:FocusBucket>Someday</enums:FocusBucket>
            </ComboBox>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
