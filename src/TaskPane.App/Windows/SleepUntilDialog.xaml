<Window x:Class="TaskPane.App.Windows.SleepUntilDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Sleep until"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="360"
        SizeToContent="Height"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Border Padding="16">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="Custom sleep"
                 FontWeight="SemiBold"
                 FontSize="15"
                 Margin="0,0,0,4" />
      <TextBlock DockPanel.Dock="Top"
                 Text="Pick a local date and time. The task stays hidden until then; deadline and priority are unchanged."
                 TextWrapping="Wrap"
                 Opacity="0.75"
                 Margin="0,0,0,14" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <ui:Button Content="Cancel"
                   Appearance="Secondary"
                   Margin="0,0,8,0"
                   IsCancel="True"
                   Click="Cancel_OnClick" />
        <ui:Button Content="Sleep"
                   Appearance="Primary"
                   IsDefault="True"
                   Click="Confirm_OnClick"
                   AutomationProperties.Name="Confirm custom sleep" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Date (YYYY-MM-DD)" Margin="0,0,0,4" Opacity="0.8" />
        <ui:TextBox x:Name="DateBox"
                    Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,12"
                    AutomationProperties.Name="Sleep until date" />
        <TextBlock Text="Time (HH:mm, 24-hour)" Margin="0,0,0,4" Opacity="0.8" />
        <ui:TextBox x:Name="TimeBox"
                    Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="Sleep until time" />
        <TextBlock x:Name="ErrorText"
                   Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
