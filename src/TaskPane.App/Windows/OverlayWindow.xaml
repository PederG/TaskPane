<Window x:Class="TaskPane.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:TaskPane.Core.Enums;assembly=TaskPane.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding DisplayName}"
        Style="{x:Null}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        MinWidth="300"
        MinHeight="{Binding OverlayMinHeight}"
        MaxWidth="900"
        MaxHeight="{Binding MaxContentHeight}"
        Width="340"
        Topmost="{Binding Topmost}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        AutomationProperties.Name="TaskPane overlay"
        KeyboardNavigation.TabNavigation="Cycle"
        SourceInitialized="OverlayWindow_OnSourceInitialized"
        LocationChanged="OverlayWindow_OnPlacementChanged"
        SizeChanged="OverlayWindow_OnPlacementChanged"
        Activated="OverlayWindow_OnActivated"
        Deactivated="OverlayWindow_OnDeactivated"
        Loaded="OverlayWindow_OnLoaded">
  <!--
    Layered host (AllowsTransparency): CompositionTarget.BackgroundColor must be Transparent
    in code — WPF defaults it to white and that paints opaque rectangular corners behind the
    rounded RootSurface. Opacity stays off the Window (must remain 1); translucency is
    brush-alpha on RootSurface (not UIElement.Opacity — that whites out on layered hosts).
    No visible ResizeGrip — edge/corner resize via WM_NCHITTEST.
    Style={x:Null} opts out of WPF-UI's implicit Window style (opaque WindowBackground /
    ClientAreaBorder template) so the compact overlay keeps a transparent rectangular HWND.
    ResizeMode stays CanResize; DWMWA_BORDER_COLOR=COLOR_NONE hides the native DWM outline.
    SetWindowRgn (CreateRoundRectRgn from RootSurface PointToScreen vs GetWindowRect; 1px
    left/top inset) clips white host outside the 18 DIP rounded RootSurface. PointToScreen
    is not re-scaled by DPI. CreateRoundRectRgn is binary/jagged — region expand would
    re-expose white host, so layered per-pixel alpha is preferred for silhouette AA; region
    stays the white-host fallback. WM_NCHITTEST: top-left/right corners resize; top-center
    ≈ TpOverlayPad (14 DIP) is HTCAPTION for empty padding drag (not over Search/Expand/More;
    respects position-locked). Corner hit squares (16 DIP) win over 6 DIP edge strips so
    HTBOTTOMRIGHT stays reachable on the rounded silhouette. DragHeader still DragMove.
    Running-session mini chrome: while a timer is active and the overlay is not focused,
    FullChrome collapses and MiniSessionStrip shows (title + elapsed + pause). Activate /
    GotFocus / strip click expands back. Stop with no focus expands (not tray minimize).
    SetWindowRgn reapplied on IsMiniSessionChrome size changes.
  -->
  <Window.Template>
    <ControlTemplate TargetType="Window">
      <Border Background="Transparent">
        <AdornerDecorator>
          <ContentPresenter />
        </AdornerDecorator>
      </Border>
    </ControlTemplate>
  </Window.Template>

  <!-- Background/BorderBrush alpha applied in code from Opacity (see ApplyRootSurfaceOpacity). -->
  <Border x:Name="RootSurface"
          Background="{StaticResource TpOverlayBgBrush}"
          BorderBrush="{StaticResource TpOverlayBorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource TpOverlayWindowRadius}"
          Padding="{StaticResource TpOverlayPadThickness}"
          SnapsToDevicePixels="True"
          SizeChanged="RootSurface_OnSizeChanged">
    <Grid>
    <!-- Mini strip while timer runs and overlay is unfocused (always-on-top, not tray). -->
    <Border x:Name="MiniSessionStrip"
            Background="Transparent"
            Visibility="{Binding IsMiniSessionChrome, Converter={StaticResource BoolToVis}}"
            MouseLeftButtonDown="MiniSessionStrip_OnMouseLeftButtonDown"
            AutomationProperties.Name="Active session mini overlay">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Symbol="ReOrderDotsVertical24"
                       FontSize="14"
                       Foreground="{StaticResource TpOverlayMetaBrush}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock Text="{Binding ActiveTaskTitle}"
                     Style="{StaticResource TpOverlayActiveTitle}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="Click to expand overlay" />
          <TextBlock Text="{Binding ActiveElapsedText}"
                     FontSize="12"
                     Foreground="{StaticResource TpOverlayMutedBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="MiniPauseButton"
                Grid.Column="2"
                Style="{StaticResource TpOverlayIconButton}"
                Width="36"
                Height="36"
                VerticalAlignment="Center"
                Command="{Binding PauseActiveCommand}"
                ToolTip="Pause timer"
                AutomationProperties.Name="Pause active timer">
          <ui:SymbolIcon Symbol="Pause24"
                         FontSize="14"
                         Foreground="{StaticResource TpOverlayTextBrush}" />
        </Button>
      </Grid>
    </Border>

    <DockPanel x:Name="FullChrome"
               LastChildFill="True"
               Visibility="{Binding IsMiniSessionChrome, Converter={StaticResource InverseBoolToVis}}">

      <!-- Header: drag + logo + wordmark + actions -->
      <Border x:Name="DragHeader"
              DockPanel.Dock="Top"
              Background="Transparent"
              Padding="0,0,0,8"
              MouseLeftButtonDown="DragHeader_OnMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ReOrderDotsVertical24"
                           FontSize="14"
                           Foreground="{StaticResource TpOverlayMetaBrush}"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center" />

            <!-- Compact three-diamond mark (visual only; brand wordmark is DisplayName) -->
            <Canvas Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
              <Path Stroke="{StaticResource TpOverlayTextBrush}"
                    StrokeThickness="1.2"
                    Fill="Transparent"
                    Data="M8,1.5 L12.5,6 L8,10.5 L3.5,6 Z" />
              <Path Stroke="{StaticResource TpOverlayMutedBrush}"
                    StrokeThickness="1.1"
                    Fill="Transparent"
                    Data="M8,5 L11.2,8.2 L8,11.4 L4.8,8.2 Z" />
              <Path Stroke="{StaticResource TpOverlayMetaBrush}"
                    StrokeThickness="1"
                    Fill="Transparent"
                    Data="M8,8.2 L10,10.2 L8,12.2 L6,10.2 Z" />
            </Canvas>

            <TextBlock Text="{Binding DisplayName}"
                       Style="{StaticResource TpOverlayWordmark}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource TpOverlayIconButton}"
                    ToolTip="Search tasks"
                    Command="{Binding ToggleSearchCommand}"
                    AutomationProperties.Name="Search tasks">
              <ui:SymbolIcon Symbol="Search24" FontSize="14" />
            </Button>
            <Button Style="{StaticResource TpOverlayIconButton}"
                    ToolTip="Open manager"
                    Command="{Binding OpenManagerCommand}"
                    AutomationProperties.Name="Open manager">
              <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="14" />
            </Button>
            <Button x:Name="MoreButton"
                    Style="{StaticResource TpOverlayIconButton}"
                    ToolTip="More"
                    Click="MoreButton_OnClick"
                    AutomationProperties.Name="More options">
              <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" />
              <Button.ContextMenu>
                <ContextMenu x:Name="MoreMenu">
                  <MenuItem Header="Hide blocked"
                            IsCheckable="True"
                            IsChecked="{Binding HideBlocked}" />
                  <MenuItem Header="Always on top"
                            IsCheckable="True"
                            IsChecked="{Binding Topmost}" />
                  <MenuItem Header="Opacity…"
                            Command="{Binding ToggleOpacityPanelCommand}" />
                  <Separator />
                  <MenuItem Header="Open manager"
                            Command="{Binding OpenManagerCommand}" />
                  <MenuItem Header="Quit"
                            Command="{Binding QuitCommand}" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Focus meta row: compact pill ComboBox with clear selected state -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
        <ComboBox DockPanel.Dock="Left"
                  Style="{StaticResource TpOverlayFocusCombo}"
                  SelectedItem="{Binding SelectedFocus}"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Focus bucket">
          <enums:FocusBucket>Inbox</enums:FocusBucket>
          <enums:FocusBucket>Today</enums:FocusBucket>
          <enums:FocusBucket>Next</enums:FocusBucket>
          <enums:FocusBucket>Someday</enums:FocusBucket>
        </ComboBox>

        <TextBlock Text="{Binding TaskCountLabel}"
                   Style="{StaticResource TpOverlayMetaText}"
                   Margin="10,0,0,0"
                   DockPanel.Dock="Left"
                   VerticalAlignment="Center" />

        <TextBlock Text="{Binding ActiveCountLabel}"
                   Style="{StaticResource TpOverlayMetaText}"
                   DockPanel.Dock="Right"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
      </DockPanel>

      <!-- Optional search -->
      <Border DockPanel.Dock="Top"
              Margin="0,0,0,10"
              Visibility="{Binding SearchOpen, Converter={StaticResource BoolToVis}}">
        <ui:TextBox PlaceholderText="Search tasks…"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="Search overlay tasks" />
      </Border>

      <!-- Optional opacity (not permanent chrome) -->
      <Border DockPanel.Dock="Top"
              Background="{StaticResource TpOverlayCardBrush}"
              CornerRadius="{StaticResource TpOverlayControlRadius}"
              Padding="10,8"
              Margin="0,0,0,10"
              Visibility="{Binding OpacityPanelOpen, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <TextBlock Text="Opacity"
                     Style="{StaticResource TpOverlayMetaText}"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center" />
          <Slider Minimum="0.45"
                  Maximum="1"
                  TickFrequency="0.05"
                  IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  Value="{Binding Opacity}"
                  AutomationProperties.Name="Overlay opacity" />
        </DockPanel>
      </Border>

      <!-- Footer -->
      <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
        <Button Style="{StaticResource TpOverlayLinkButton}"
                Command="{Binding ToggleSleepingListCommand}"
                AutomationProperties.Name="Sleeping and completed counts">
          <TextBlock Text="{Binding FooterCountsLabel}"
                     Style="{StaticResource TpOverlayFooterText}" />
        </Button>

        <Button DockPanel.Dock="Right"
                Style="{StaticResource TpOverlayLinkButton}"
                HorizontalAlignment="Right"
                Padding="4,0"
                Command="{Binding OpenManagerCommand}"
                AutomationProperties.Name="Open manager from footer">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Open manager"
                       FontSize="12"
                       Foreground="{StaticResource TpOverlayMutedBrush}"
                       VerticalAlignment="Center" />
            <ui:SymbolIcon Symbol="ArrowUpRight24"
                           FontSize="12"
                           Foreground="{StaticResource TpOverlayMutedBrush}"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </DockPanel>

      <!-- Status (ephemeral) -->
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding StatusMessage}"
                 Foreground="{StaticResource TpOverlayMetaBrush}"
                 FontSize="11"
                 Margin="0,4,0,0"
                 TextTrimming="CharacterEllipsis">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- Sleeping expand -->
      <ListBox DockPanel.Dock="Bottom"
               ItemsSource="{Binding SleepingTasks}"
               Background="Transparent"
               BorderThickness="0"
               MaxHeight="90"
               Margin="0,0,0,6"
               Visibility="{Binding ShowSleeping, Converter={StaticResource BoolToVis}}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource TpOverlayListBoxItem}" />
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Style="{StaticResource TpOverlayGhostButton}"
                      Content="Wake"
                      Padding="8,2"
                      Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      ToolTip="Wake immediately"
                      AutomationProperties.Name="Wake immediately" />
              <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding Title}"
                           Foreground="{StaticResource TpOverlayMutedBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SleepWakeText}"
                           Foreground="{StaticResource TpOverlayMetaBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Sleep wake time" />
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Quick add -->
      <Border DockPanel.Dock="Bottom"
              Background="{StaticResource TpOverlayCardBrush}"
              CornerRadius="{StaticResource TpOverlayCardRadius}"
              Padding="10,8"
              Margin="0,4,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Symbol="Add24"
                         FontSize="14"
                         Foreground="{StaticResource TpOverlayMutedBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
          <TextBox x:Name="QuickAddBox"
                   Grid.Column="1"
                   Background="Transparent"
                   BorderThickness="0"
                   CaretBrush="{StaticResource TpOverlayTextBrush}"
                   Foreground="{StaticResource TpOverlayTextBrush}"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="QuickAddBox_OnKeyDown"
                   AutomationProperties.Name="Quick add task">
            <TextBox.Style>
              <Style TargetType="TextBox">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                      <Grid>
                        <TextBlock x:Name="Placeholder"
                                   Text="Add a task…"
                                   Foreground="{StaticResource TpOverlayMetaBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Background="Transparent" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <MultiTrigger>
                          <MultiTrigger.Conditions>
                            <Condition Property="Text" Value="" />
                            <Condition Property="IsKeyboardFocused" Value="False" />
                          </MultiTrigger.Conditions>
                          <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </TextBox.Style>
          </TextBox>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      IsHitTestVisible="False">
            <TextBlock Text="Enter"
                       FontSize="11"
                       Foreground="{StaticResource TpOverlayMetaBrush}"
                       VerticalAlignment="Center" />
            <ui:SymbolIcon Symbol="ArrowEnterLeft24"
                           FontSize="12"
                           Foreground="{StaticResource TpOverlayMetaBrush}"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Notes popover: compact when viewing; expands only while editing -->
      <Border DockPanel.Dock="Bottom"
              Background="{StaticResource TpOverlayElevatedBrush}"
              Padding="10"
              CornerRadius="{StaticResource TpOverlayCardRadius}"
              Margin="0,0,0,8"
              Visibility="{Binding NotePopoverOpen, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left"
                       Text="Notes"
                       Foreground="{StaticResource TpOverlayMetaBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBlock Text="{Binding NotePreviewTask.Title}"
                       Foreground="{StaticResource TpOverlayTextBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
          </DockPanel>

          <!-- Compact preview (not editing) -->
          <DockPanel Visibility="{Binding IsNoteEditing, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource TpOverlayGhostButton}"
                      Content="Edit"
                      Padding="8,4"
                      Margin="0,0,4,0"
                      Command="{Binding BeginEditNotesCommand}"
                      AutomationProperties.Name="Edit task notes" />
              <Button Style="{StaticResource TpOverlayGhostButton}"
                      Content="Close"
                      Padding="8,4"
                      Command="{Binding CloseNotesCommand}"
                      AutomationProperties.Name="Close notes" />
            </StackPanel>
            <TextBlock Text="{Binding NoteCompactBody}"
                       Foreground="{StaticResource TpOverlayMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,8,0" />
          </DockPanel>

          <!-- Expanded Markdown/plain-text editor -->
          <StackPanel Visibility="{Binding IsNoteEditing, Converter={StaticResource BoolToVis}}">
            <TextBox Text="{Binding NoteDraftText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="88"
                     MaxHeight="180"
                     VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource TpOverlayCardBrush}"
                     BorderBrush="{StaticResource TpOverlayBorderBrush}"
                     BorderThickness="1"
                     CaretBrush="{StaticResource TpOverlayTextBrush}"
                     Foreground="{StaticResource TpOverlayTextBrush}"
                     Padding="8,6"
                     AutomationProperties.Name="Task notes editor" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
              <Button Style="{StaticResource TpOverlayGhostButton}"
                      Content="Cancel"
                      Padding="8,4"
                      Margin="0,0,4,0"
                      Command="{Binding CancelNotesEditCommand}"
                      AutomationProperties.Name="Cancel notes edit" />
              <Button Style="{StaticResource TpOverlayGhostButton}"
                      Content="Save"
                      Padding="8,4"
                      Command="{Binding SaveNotesCommand}"
                      AutomationProperties.Name="Save task notes" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Active task card (only while a timer is running; no duplicate elapsed elsewhere) -->
      <Border DockPanel.Dock="Top"
              Background="{StaticResource TpOverlayActiveCardBrush}"
              CornerRadius="{StaticResource TpOverlayCardRadius}"
              Padding="12,10"
              Margin="0,0,0,10"
              Visibility="{Binding HasActiveTask, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <ui:SymbolIcon Symbol="Clock24"
                             FontSize="12"
                             Foreground="{StaticResource TpOverlayMutedBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
              <TextBlock Text="Currently working on"
                         FontSize="12"
                         Foreground="{StaticResource TpOverlayMutedBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding ActiveTaskTitle}"
                       Style="{StaticResource TpOverlayActiveTitle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="{Binding ActiveElapsedText}"
                       FontSize="12"
                       Foreground="{StaticResource TpOverlayMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Style="{StaticResource TpOverlayIconButton}"
                  Width="36"
                  Height="36"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  Command="{Binding PauseActiveCommand}"
                  ToolTip="Pause timer"
                  AutomationProperties.Name="Pause active timer">
            <ui:SymbolIcon Symbol="Pause24"
                           FontSize="14"
                           Foreground="{StaticResource TpOverlayTextBrush}" />
          </Button>
        </Grid>
      </Border>

      <!-- Task list (max height keeps SizeToContent measurable) -->
      <ListBox ItemsSource="{Binding VisibleTasks}"
               Background="Transparent"
               BorderThickness="0"
               MaxHeight="{Binding TaskListMaxHeight}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True"
               ScrollViewer.CanContentScroll="True">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource TpOverlayListBoxItem}" />
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <!-- Subtasks indent the whole row (checkbox + title) for hierarchy. -->
            <Grid MinHeight="28">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Margin" Value="0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                      <Setter Property="Margin" Value="16,0,0,0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0"
                      Style="{StaticResource TpOverlayCompleteButton}"
                      VerticalAlignment="Center"
                      Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="Complete task">
                <Grid>
                  <ui:SymbolIcon Symbol="Circle24"
                                 FontSize="16"
                                 Foreground="{StaticResource TpOverlayCheckboxBrush}">
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                  <ui:SymbolIcon Symbol="CheckmarkCircle24"
                                 FontSize="16"
                                 Foreground="#FF8EB7E0">
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                </Grid>
              </Button>

              <Grid Grid.Column="1" Margin="4,0,8,0">
                <TextBlock Text="{Binding Title}"
                           Cursor="Hand"
                           MouseLeftButtonUp="TaskTitle_OnMouseLeftButtonUp"
                           ToolTip="{Binding MetaText}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TpOverlayTaskTitle}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource TpOverlayMutedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource TpOverlayDangerBrush}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource TpOverlayCautionBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         Foreground="{StaticResource TpOverlayTextBrush}"
                         CaretBrush="{StaticResource TpOverlayTextBrush}"
                         BorderThickness="0,0,0,1"
                         BorderBrush="{StaticResource TpOverlayBorderBrush}"
                         Padding="0,1"
                         FontSize="13"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Edit task title"
                         IsVisibleChanged="TitleEditBox_OnIsVisibleChanged"
                         LostFocus="TitleEditBox_OnLostFocus"
                         PreviewKeyDown="TitleEditBox_OnPreviewKeyDown">
                  <TextBox.Style>
                    <Style TargetType="TextBox">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
              </Grid>

              <!-- Play / active pulse (elapsed lives on the active card only) -->
              <Button Grid.Column="2"
                      Style="{StaticResource TpOverlayIconButton}"
                      Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      ToolTip="Start, switch, or stop timer"
                      AutomationProperties.Name="Toggle timer">
                <Grid>
                  <ui:SymbolIcon Symbol="PlayCircle24" FontSize="16">
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                  <ui:SymbolIcon Symbol="SoundWaveCircle24" FontSize="16">
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                </Grid>
              </Button>

              <!-- Row overflow: sleep / subtask / expand / delete / notes (soft-delete) -->
              <Button Grid.Column="3"
                      Style="{StaticResource TpOverlayIconButton}"
                      Click="TaskRowMenu_OnClick"
                      ToolTip="Task actions"
                      AutomationProperties.Name="Task actions">
                <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" />
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Sleep">
                      <MenuItem Header="1 hour"
                                Tag="OneHour"
                                Click="TaskMenuSleepPreset_OnClick" />
                      <MenuItem Header="Tomorrow morning"
                                Tag="TomorrowMorning"
                                Click="TaskMenuSleepPreset_OnClick" />
                      <MenuItem Header="Next week"
                                Tag="NextWeek"
                                Click="TaskMenuSleepPreset_OnClick" />
                      <MenuItem Header="Indefinitely"
                                Tag="Indefinitely"
                                Click="TaskMenuSleepPreset_OnClick" />
                      <MenuItem Header="Custom date/time…"
                                Tag="Custom"
                                Click="TaskMenuSleepPreset_OnClick" />
                      <Separator />
                      <MenuItem Header="Wake immediately"
                                Click="TaskMenuWake_OnClick" />
                    </MenuItem>
                    <MenuItem Header="Add subtask"
                              Click="TaskMenuAddSubtask_OnClick">
                      <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                          <Setter Property="IsEnabled" Value="True" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                              <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="Expand / collapse"
                              Click="TaskMenuExpand_OnClick" />
                    <MenuItem Header="Notes"
                              Click="TaskMenuNotes_OnClick" />
                    <Separator />
                    <MenuItem Header="Delete"
                              Click="TaskMenuDelete_OnClick" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    </Grid>
  </Border>
</Window>
