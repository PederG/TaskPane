<Window x:Class="TaskPane.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:TaskPane.Core.Enums;assembly=TaskPane.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="TaskPane"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="300"
        MinHeight="240"
        MaxWidth="900"
        MaxHeight="1200"
        Topmost="{Binding Topmost}"
        Opacity="{Binding Opacity}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        LocationChanged="OverlayWindow_OnPlacementChanged"
        SizeChanged="OverlayWindow_OnPlacementChanged">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#E61B2230" />
    <SolidColorBrush x:Key="OverlayHeaderBrush" Color="#33202838" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#55A8B4C8" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="OverlayMutedBrush" Color="#B8D5E4F5" />
    <SolidColorBrush x:Key="OverlayMetaBrush" Color="#99C5D8EA" />
    <SolidColorBrush x:Key="OverlayDangerBrush" Color="#FFFF8A80" />
    <SolidColorBrush x:Key="OverlayCautionBrush" Color="#FFFFD180" />
  </Window.Resources>

  <Border Background="{StaticResource OverlaySurfaceBrush}"
          BorderBrush="{StaticResource OverlayBorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource TpRadiusLg}"
          Padding="10">
    <DockPanel>
      <Border x:Name="DragHeader"
              DockPanel.Dock="Top"
              Background="{StaticResource OverlayHeaderBrush}"
              CornerRadius="{StaticResource TpRadiusMd}"
              Padding="10,8"
              MouseLeftButtonDown="DragHeader_OnMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="ClipboardTaskListLtr24"
                           Foreground="{StaticResource OverlayTextBrush}"
                           FontSize="16"
                           Margin="0,0,8,0" />
            <TextBlock Text="TaskPane"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OverlayTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <ComboBox Width="118"
                      SelectedItem="{Binding SelectedFocus}"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center">
              <enums:FocusBucket>Inbox</enums:FocusBucket>
              <enums:FocusBucket>Today</enums:FocusBucket>
              <enums:FocusBucket>Next</enums:FocusBucket>
              <enums:FocusBucket>Someday</enums:FocusBucket>
            </ComboBox>
            <CheckBox Content="Hide blocked"
                      IsChecked="{Binding HideBlocked}"
                      Foreground="{StaticResource OverlayMutedBrush}"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Hide blocked tasks" />
          </StackPanel>
          <ui:Button Grid.Column="1"
                     Width="34"
                     Height="30"
                     Padding="0"
                     Appearance="Transparent"
                     ToolTip="Open manager"
                     Command="{Binding OpenManagerCommand}"
                     AutomationProperties.Name="Open manager">
            <ui:SymbolIcon Symbol="ArrowMaximize24" Foreground="{StaticResource OverlayTextBrush}" />
          </ui:Button>
        </Grid>
      </Border>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <Border Background="#CC15202C"
                Padding="10"
                CornerRadius="{StaticResource TpRadiusMd}"
                Margin="0,0,0,8"
                Visibility="{Binding NotePopoverOpen, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <ui:Button DockPanel.Dock="Right"
                       Content="Close"
                       Appearance="Secondary"
                       Padding="8,4"
                       Command="{Binding CloseNotesCommand}" />
            <StackPanel>
              <TextBlock Text="Notes preview"
                         Foreground="{StaticResource OverlayMetaBrush}"
                         FontSize="11"
                         Margin="0,0,0,4" />
              <TextBlock Text="{Binding NotePreviewTask.Title}"
                         Foreground="{StaticResource OverlayTextBrush}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding NotePreviewTask.Notes}"
                         Foreground="{StaticResource OverlayMutedBrush}"
                         TextWrapping="Wrap"
                         Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <ui:Button Content="{Binding SleepingTasks.Count, StringFormat=◷ {0} sleeping tasks}"
                   Appearance="Transparent"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,6"
                   Padding="6,3"
                   Foreground="{StaticResource OverlayMutedBrush}"
                   Command="{Binding ToggleSleepingListCommand}"
                   Visibility="{Binding HasSleepingTasks, Converter={StaticResource BoolToVis}}" />
        <ListBox ItemsSource="{Binding SleepingTasks}"
                 Background="Transparent"
                 BorderThickness="0"
                 MaxHeight="100"
                 Visibility="{Binding ShowSleeping, Converter={StaticResource BoolToVis}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <ui:Button DockPanel.Dock="Right"
                           Content="Wake"
                           Appearance="Secondary"
                           Padding="6,2"
                           Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource OverlayMutedBrush}" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox x:Name="QuickAddBox"
                      PlaceholderText="Quick add to Inbox"
                      Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                      KeyDown="QuickAddBox_OnKeyDown"
                      AutomationProperties.Name="Quick add task" />
          <ui:Button Grid.Column="1"
                     Width="36"
                     Height="34"
                     Margin="6,0,0,0"
                     Appearance="Primary"
                     Command="{Binding QuickAddCommand}"
                     ToolTip="Add to Inbox"
                     AutomationProperties.Name="Add task to Inbox">
            <ui:SymbolIcon Symbol="Add24" />
          </ui:Button>
        </Grid>
        <DockPanel Margin="0,8,0,0">
          <TextBlock Text="Opacity"
                     Foreground="{StaticResource OverlayMutedBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <Slider Minimum="0.45"
                  Maximum="1"
                  TickFrequency="0.05"
                  IsSnapToTickEnabled="True"
                  Value="{Binding Opacity}" />
        </DockPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{StaticResource OverlayMetaBrush}"
                   FontSize="11"
                   Margin="0,4,0,0" />
      </StackPanel>

      <ListBox ItemsSource="{Binding VisibleTasks}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               Margin="0,8,0,0"
               VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="RowBd"
                          Background="Transparent"
                          CornerRadius="6"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="RowBd" Property="Background" Value="#22FFFFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0"
                         Width="22" Height="22" Padding="0"
                         Appearance="Transparent"
                         Foreground="#EEFFFFFF"
                         Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                         Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         AutomationProperties.Name="Expand subtasks">
                <ui:Button.Style>
                  <Style TargetType="ui:Button">
                    <Setter Property="Content" Value="▸" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="Content" Value="▾" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>
              <CheckBox Grid.Column="1"
                        IsChecked="{Binding IsCompleted, Mode=OneWay}"
                        Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Complete task" />
              <StackPanel Grid.Column="2" Margin="6,0,4,0">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Cursor="Hand"
                           MouseLeftButtonUp="TaskTitle_OnMouseLeftButtonUp">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource OverlayTextBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                          <Setter Property="Margin" Value="12,0,0,0" />
                          <Setter Property="Foreground" Value="{StaticResource OverlayMutedBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource OverlayDangerBrush}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource OverlayCautionBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding MetaText}"
                           Foreground="{StaticResource OverlayMetaBrush}"
                           FontSize="11" />
                <TextBlock Text="{Binding NotesPreview}"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <ui:Button Grid.Column="3"
                         Content="{Binding TimerButtonLabel}"
                         MinWidth="28" Height="24" Margin="2,0" Padding="4,0"
                         Appearance="Secondary"
                         Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         ToolTip="Start, switch, or stop timer"
                         AutomationProperties.Name="Toggle timer" />
              <ui:Button Grid.Column="4"
                         Content="Zzz"
                         MinWidth="34" Height="24" Margin="2,0" Padding="4,0"
                         Appearance="Transparent"
                         Foreground="{StaticResource OverlayMutedBrush}"
                         Command="{Binding DataContext.SleepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         ToolTip="Sleep 1 hour"
                         AutomationProperties.Name="Sleep task" />
              <ui:Button Grid.Column="5"
                         Content="+"
                         Width="26" Height="24" Margin="2,0" Padding="0"
                         Appearance="Transparent"
                         Foreground="{StaticResource OverlayMutedBrush}"
                         Command="{Binding DataContext.AddSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         ToolTip="Add subtask"
                         AutomationProperties.Name="Add subtask">
                <ui:Button.Style>
                  <Style TargetType="ui:Button">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
              </ui:Button>
              <ui:Button Grid.Column="6"
                         Content="Delete"
                         MinWidth="52" Height="24" Padding="6,0" Margin="2,0,0,0"
                         Appearance="Danger"
                         Command="{Binding DataContext.SoftDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         ToolTip="Move to recycle bin"
                         AutomationProperties.Name="Delete task" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</Window>
