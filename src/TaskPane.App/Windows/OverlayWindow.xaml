<Window x:Class="TaskPane.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:TaskPane.Core.Enums;assembly=TaskPane.Core"
        Title="TaskPane"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#E61E2430"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="280"
        MinHeight="220"
        MaxWidth="900"
        MaxHeight="1200"
        Topmost="{Binding Topmost}"
        Opacity="{Binding Opacity}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        LocationChanged="OverlayWindow_OnPlacementChanged"
        SizeChanged="OverlayWindow_OnPlacementChanged">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Border BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10">
    <DockPanel>
      <Border x:Name="DragHeader"
              DockPanel.Dock="Top"
              Background="#33000000"
              Padding="8,6"
              MouseLeftButtonDown="DragHeader_OnMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="TaskPane" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Width="120"
                      SelectedItem="{Binding SelectedFocus}">
              <enums:FocusBucket>Inbox</enums:FocusBucket>
              <enums:FocusBucket>Today</enums:FocusBucket>
              <enums:FocusBucket>Next</enums:FocusBucket>
              <enums:FocusBucket>Someday</enums:FocusBucket>
            </ComboBox>
          </StackPanel>
          <Button Grid.Column="1" Content="⤢" Width="32" Height="28" Margin="4,0"
                  ToolTip="Open manager"
                  Command="{Binding OpenManagerCommand}"
                  AutomationProperties.Name="Open manager" />
        </Grid>
      </Border>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <Border Background="#CC15202C"
                Padding="10"
                CornerRadius="6"
                Margin="0,0,0,8"
                Visibility="{Binding NotePopoverOpen, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Close" Padding="8,4" Command="{Binding CloseNotesCommand}" />
            <StackPanel>
              <TextBlock Text="Notes preview" Foreground="#AADDEEFF" FontSize="11" Margin="0,0,0,4" />
              <TextBlock Text="{Binding NotePreviewTask.Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding NotePreviewTask.Notes}" Foreground="#EEFFFFFF" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Button Content="{Binding SleepingTasks.Count, StringFormat=◷ {0} sleeping tasks}"
                HorizontalAlignment="Left"
                Margin="0,0,0,6"
                Padding="6,3"
                Command="{Binding ToggleSleepingListCommand}"
                Visibility="{Binding HasSleepingTasks, Converter={StaticResource BoolToVis}}" />
        <ListBox ItemsSource="{Binding SleepingTasks}"
                 Background="Transparent"
                 BorderThickness="0"
                 MaxHeight="100"
                 Visibility="{Binding ShowSleeping, Converter={StaticResource BoolToVis}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Wake" Padding="6,2"
                        Command="{Binding DataContext.WakeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
                <TextBlock Text="{Binding Title}" Foreground="#CCFFFFFF" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="QuickAddBox"
                   Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="8,6"
                   KeyDown="QuickAddBox_OnKeyDown"
                   AutomationProperties.Name="Quick add task" />
          <Button Grid.Column="1" Content="+" Width="36" Margin="6,0,0,0"
                  Command="{Binding QuickAddCommand}"
                  ToolTip="Add to Inbox"
                  AutomationProperties.Name="Add task to Inbox" />
        </Grid>
        <DockPanel Margin="0,6,0,0">
          <TextBlock Text="Opacity" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Slider Minimum="0.45" Maximum="1" TickFrequency="0.05"
                  IsSnapToTickEnabled="True" Value="{Binding Opacity}" />
        </DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#CCFFFFFF" FontSize="11" Margin="0,4,0,0" />
      </StackPanel>

      <ListBox ItemsSource="{Binding VisibleTasks}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               Margin="0,8,0,0"
               VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0"
                      Width="22" Height="22" Padding="0"
                      Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                      Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="Expand subtasks">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Content" Value="▸" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="Content" Value="▾" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <CheckBox Grid.Column="1"
                        IsChecked="{Binding IsCompleted, Mode=OneWay}"
                        Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Complete task" />
              <StackPanel Grid.Column="2" Margin="6,0,0,0">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Cursor="Hand"
                           MouseLeftButtonUp="TaskTitle_OnMouseLeftButtonUp">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="White" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                          <Setter Property="Margin" Value="12,0,0,0" />
                          <Setter Property="Foreground" Value="#E6FFFFFF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                          <Setter Property="Foreground" Value="#FFFF8A80" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding MetaText}"
                           Foreground="#AADDEEFF"
                           FontSize="11" />
                <TextBlock Text="{Binding NotesPreview}"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <Button Grid.Column="3"
                      Content="{Binding TimerButtonLabel}"
                      Width="28" Height="22" Margin="4,0"
                      Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      ToolTip="Start, switch, or stop timer"
                      AutomationProperties.Name="Toggle timer" />
              <Button Grid.Column="4"
                      Content="Zzz"
                      Width="34" Height="22" Margin="4,0"
                      Command="{Binding DataContext.SleepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      ToolTip="Sleep 1 hour"
                      AutomationProperties.Name="Sleep task" />
              <Button Grid.Column="5"
                      Content="+"
                      Width="26" Height="22" Margin="4,0"
                      Command="{Binding DataContext.AddSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      ToolTip="Add subtask"
                      AutomationProperties.Name="Add subtask">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSubtask}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Grid.Column="6"
                      Content="⋯"
                      Width="28" Height="22"
                      Command="{Binding DataContext.SoftDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"
                      ToolTip="Soft delete"
                      AutomationProperties.Name="Soft delete task" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</Window>
