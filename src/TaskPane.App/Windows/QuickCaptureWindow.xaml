<Window x:Class="TaskPane.App.Windows.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick capture — TaskPane"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F01E2430"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="420"
        Height="120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        KeyDown="QuickCaptureWindow_OnKeyDown">
  <Border BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top"
                 Text="Quick capture to Inbox"
                 Foreground="White"
                 FontWeight="SemiBold"
                 Margin="0,0,0,8" />
      <TextBox x:Name="TitleBox"
               Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
               Padding="10,8"
               FontSize="16"
               KeyDown="TitleBox_OnKeyDown"
               AutomationProperties.Name="Quick capture title" />
    </DockPanel>
  </Border>
</Window>
