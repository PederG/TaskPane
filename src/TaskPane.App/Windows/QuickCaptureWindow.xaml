<Window x:Class="TaskPane.App.Windows.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Quick capture — TaskPane"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="440"
        Height="128"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        KeyDown="QuickCaptureWindow_OnKeyDown">
  <Border Background="#F01B2230"
          BorderBrush="#55A8B4C8"
          BorderThickness="1"
          CornerRadius="{StaticResource TpRadiusLg}"
          Padding="14">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
        <ui:SymbolIcon Symbol="Flash24" Foreground="#F2FFFFFF" Margin="0,0,8,0" FontSize="16" />
        <TextBlock Text="Quick capture to Inbox"
                   Foreground="#F2FFFFFF"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>
      <ui:TextBox x:Name="TitleBox"
                  PlaceholderText="Task title — Enter to save, Esc to dismiss"
                  Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                  FontSize="16"
                  KeyDown="TitleBox_OnKeyDown"
                  AutomationProperties.Name="Quick capture title" />
    </DockPanel>
  </Border>
</Window>
