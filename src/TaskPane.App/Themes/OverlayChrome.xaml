<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Compact overlay palette (charcoal / slate) matching approved mockup -->
  <Color x:Key="TpOverlayBgColor">#E61A1C23</Color>
  <Color x:Key="TpOverlayCardColor">#CC252830</Color>
  <Color x:Key="TpOverlayElevatedColor">#FF2A2D36</Color>
  <Color x:Key="TpOverlayPillColor">#FFC8D0DC</Color>
  <Color x:Key="TpOverlayTextColor">#FFF4F6FA</Color>
  <Color x:Key="TpOverlayMutedColor">#FF9AA3B2</Color>
  <Color x:Key="TpOverlayMetaColor">#FF7A8494</Color>
  <Color x:Key="TpOverlayBorderColor">#33FFFFFF</Color>
  <Color x:Key="TpOverlayDangerColor">#FFFF8A80</Color>
  <Color x:Key="TpOverlayCautionColor">#FFFFD180</Color>
  <Color x:Key="TpOverlayRowHoverColor">#14FFFFFF</Color>
  <Color x:Key="TpOverlayCheckboxColor">#FF6B7380</Color>

  <SolidColorBrush x:Key="TpOverlayBgBrush" Color="{StaticResource TpOverlayBgColor}" />
  <SolidColorBrush x:Key="TpOverlayCardBrush" Color="{StaticResource TpOverlayCardColor}" />
  <SolidColorBrush x:Key="TpOverlayElevatedBrush" Color="{StaticResource TpOverlayElevatedColor}" />
  <SolidColorBrush x:Key="TpOverlayPillBrush" Color="{StaticResource TpOverlayPillColor}" />
  <SolidColorBrush x:Key="TpOverlayTextBrush" Color="{StaticResource TpOverlayTextColor}" />
  <SolidColorBrush x:Key="TpOverlayMutedBrush" Color="{StaticResource TpOverlayMutedColor}" />
  <SolidColorBrush x:Key="TpOverlayMetaBrush" Color="{StaticResource TpOverlayMetaColor}" />
  <SolidColorBrush x:Key="TpOverlayBorderBrush" Color="{StaticResource TpOverlayBorderColor}" />
  <SolidColorBrush x:Key="TpOverlayDangerBrush" Color="{StaticResource TpOverlayDangerColor}" />
  <SolidColorBrush x:Key="TpOverlayCautionBrush" Color="{StaticResource TpOverlayCautionColor}" />
  <SolidColorBrush x:Key="TpOverlayRowHoverBrush" Color="{StaticResource TpOverlayRowHoverColor}" />
  <SolidColorBrush x:Key="TpOverlayCheckboxBrush" Color="{StaticResource TpOverlayCheckboxColor}" />

  <CornerRadius x:Key="TpOverlayWindowRadius">18</CornerRadius>
  <CornerRadius x:Key="TpOverlayCardRadius">12</CornerRadius>
  <CornerRadius x:Key="TpOverlayPillRadius">10</CornerRadius>
  <CornerRadius x:Key="TpOverlayControlRadius">8</CornerRadius>
  <sys:Double x:Key="TpOverlayPad">14</sys:Double>
  <sys:Double x:Key="TpOverlayGap">10</sys:Double>
  <Thickness x:Key="TpOverlayPadThickness">14</Thickness>
  <Thickness x:Key="TpOverlaySectionGap">0,0,0,10</Thickness>

  <Style x:Key="TpOverlayIconButton" TargetType="ui:Button">
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Appearance" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TpOverlayMutedBrush}" />
  </Style>

  <Style x:Key="TpOverlayGhostButton" TargetType="ui:Button" BasedOn="{StaticResource TpOverlayIconButton}">
    <Setter Property="Width" Value="Auto" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style x:Key="TpOverlayWordmark" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TpOverlayTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TpOverlayMetaText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TpOverlayMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TpOverlayFooterText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TpOverlayMetaBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TpOverlayTaskTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TpOverlayTextBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TpOverlayActiveTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TpOverlayTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="TpOverlayListBoxItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="4,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="RowBd"
                  Background="Transparent"
                  CornerRadius="{StaticResource TpOverlayControlRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="RowBd" Property="Background" Value="{StaticResource TpOverlayRowHoverBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
